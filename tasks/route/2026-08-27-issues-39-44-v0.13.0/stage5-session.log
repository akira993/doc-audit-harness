+  for n in ('git','gh','rsync','python3'):q=self.bin+'/'+n;open(q,'w').write('#!'+sys.executable+'\n'+FAKE);os.chmod(q,0o755)
+ def save(self):json.dump(self.s,open(self.p,'w'))
+ def load(self):self.s=json.load(open(self.p));return self.s
+ def handoff(self,*a,root=None):return subprocess.run(['/bin/bash',HANDOFF,*a],cwd=self.repo,env=os.environ|{'PATH':self.bin+':/usr/bin:/bin','FAKE_STATE':self.p,'FAKE_LOG':self.l,'DOCAUDIT_SKILLS_DIR':self.dest,'DOCAUDIT_SKILLS_ROOT':root or self.root},input='y\n',text=True,capture_output=True)
+ def calls(self):return [json.loads(x) for x in open(self.l)] if os.path.exists(self.l) else []
+ def no_publish(self):self.assertFalse(any(c['tool'] in ('gh','rsync') or (c['tool']=='git' and c['args'][0] in ('tag','push')) for c in self.calls()))
+ def test_bad_sha_and_fetch_fail_closed(self):
+  self.assertNotEqual(self.handoff('bad','9').returncode,0);self.assertEqual(self.calls(),[]);self.s['fetch_fail']=True;self.save();self.assertNotEqual(self.handoff(SHA,'9').returncode,0)
+ def test_tag_mismatch_stops(self):self.s['local'][TAG]='c'*40;self.save();self.assertNotEqual(self.handoff(SHA,'9').returncode,0);self.no_publish()
+ def test_success_and_resume_tag_release_issues(self):
+  p=self.handoff(SHA,'77');self.assertEqual(p.returncode,0,p.stderr);s=self.load();self.assertEqual(s['local'][TAG],SHA);self.assertEqual(s['releases'][TAG]['title'],TITLE);self.assertTrue(all(x in s['releases'][TAG]['body'] for x in (SHA,'#39','#44','codexReview.required','--break-lock')));self.assertEqual(set(s['closed']),{str(i) for i in range(39,45)});self.assertEqual(self.handoff(SHA,'77').returncode,0)
+ def test_single_refspec_and_scratch_not_pushed(self):
+  self.s['local']['scratch-tag']=SHA;self.save();self.assertEqual(self.handoff(SHA,'9').returncode,0);self.assertEqual([c['args'] for c in self.calls() if c['tool']=='git' and c['args'][0]=='push'],[['push','origin','refs/tags/docaudit--v0.13.0:refs/tags/docaudit--v0.13.0']])
+ def test_symlink_or_outside_preflight_has_no_mutations(self):
