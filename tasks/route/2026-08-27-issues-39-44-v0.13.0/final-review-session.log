 def glob_to_regex(pattern):
     """`**` -> any incl '/', `*` -> any except '/', `?` -> single except '/'."""
     out, i, n = [], 0, len(pattern)
     while i < n:
         c = pattern[i]
         if c == "*":
             if i + 1 < n and pattern[i + 1] == "*":
                 if i + 2 < n and pattern[i + 2] == "/":
                     out.append("(.*/)?"); i += 3
                 else:
