     1	#!/usr/bin/env python3
     2	"""Seal a run after detecting Phase-1-to-fan-out drift."""
     3	
     4	import argparse
     5	import hashlib
     6	import json
     7	import os
     8	import subprocess
     9	import sys
    10	import tempfile
    11	
    12	
    13	HERE = os.path.dirname(os.path.abspath(__file__))
    14	
    15	
    16	def atomic_write(path, raw):
    17	    fd, temporary = tempfile.mkstemp(prefix=".manifest.", dir=os.path.dirname(path))
    18	    try:
    19	        with os.fdopen(fd, "wb") as handle:
    20	            handle.write(raw)
    21	            handle.flush()
    22	            os.fsync(handle.fileno())
    23	        os.replace(temporary, path)
    24	    finally:
    25	        if os.path.exists(temporary):
    26	            os.unlink(temporary)
    27	
    28	
    29	def emit(value, code):
    30	    print(json.dumps(value, sort_keys=True))
    31	    return code
    32	
    33	
    34	def main():
    35	    parser = argparse.ArgumentParser()
    36	    parser.add_argument("--run-dir", required=True)
    37	    parser.add_argument("--repo-root", required=True)
    38	    parser.add_argument("--evidence", required=True)
    39	    args = parser.parse_args()
    40	    try:
    41	        evidence = json.loads(args.evidence)
    42	        if os.path.realpath(str(evidence.get("runDir"))) != os.path.realpath(args.run_dir):
    43	            raise ValueError("EVIDENCE runDir mismatch")
    44	        with open(os.path.join(args.run_dir, "manifest.json"), "rb") as handle:
    45	            manifest_raw = handle.read()
    46	        if "sha256:" + hashlib.sha256(manifest_raw).hexdigest() != evidence.get("manifest"):
    47	            raise ValueError("manifest sha does not match EVIDENCE")
    48	        manifest = json.loads(manifest_raw.decode("utf-8"))
    49	        config = os.path.join(os.path.realpath(args.repo_root), ".claude", "doc-audit.json")
    50	        change = subprocess.run(
    51	            [sys.executable, os.path.join(HERE, "change-set-sha.py"),
    52	             "--repo-root", args.repo_root, "--baseline-sha", manifest["baselineSha"],
    53	             "--config", config], capture_output=True, text=True)
    54	        if change.returncode:
    55	            raise ValueError(change.stderr.strip() or "change-set-sha failed")
    56	        current_change = json.loads(change.stdout)
    57	        head = subprocess.run(["git", "-C", args.repo_root, "rev-parse", "HEAD"],
    58	                              capture_output=True, text=True, check=True).stdout.strip()
    59	        if current_change["changeSetSha"] != manifest.get("changeSetSha"):
    60	            return emit({"sealed": False, "reason": "change-set-drift"}, 5)
    61	        if head != manifest.get("head"):
