    20	                    i += 2
    21	            else:
    22	                out.append("[^/]*")
    23	                i += 1
    24	        elif char == "?":
    25	            out.append("[^/]")
    26	            i += 1
    27	        else:
    28	            out.append(re.escape(char))
    29	            i += 1
    30	    return re.compile("^" + "".join(out) + "$")
