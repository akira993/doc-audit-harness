 with open(sys.argv[1], "wb") as handle:
     handle.write(b"x" * (2 * 1024 * 1024 + 1))
 PY
     ;;
   timeout_once)
     case "$out" in
       */attempt-01-*)
         (trap '' TERM; sleep 1; emit "$out" "$runid" "$doc") &
         trap '' TERM
         sleep 10
         ;;
       *) emit "$out" "$runid" "$doc" ;;
     esac
     ;;
   parallel)
     counter 1
     sleep 0.2
     emit "$out" "$runid" "$doc"
     counter -1
     ;;
   *) exit 9 ;;
 esac
