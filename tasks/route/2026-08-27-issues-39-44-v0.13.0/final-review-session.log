---CODEX REVIEW PLAN---
     1	#!/usr/bin/env python3
     2	"""Choose the deterministic Phase-4 codex-review action."""
     3	
     4	import argparse
     5	import json
     6	
     7	from docaudit_cache import CODEX_REVIEW_STATES
     8	
     9	
    10	def parse_bool(value):
    11	    return value == "true"
    12	
    13	
    14	def main():
    15	    parser = argparse.ArgumentParser()
    16	    parser.add_argument("--mode", required=True, choices=["incremental", "full"])
    17	    parser.add_argument("--config", required=True)
    18	    parser.add_argument("--available", required=True, choices=["true", "false"])
    19	    parser.add_argument("--available-reason", default="not-installed")
    20	    parser.add_argument("--baseline-ok", required=True, choices=["true", "false"])
    21	    args = parser.parse_args()
    22	
    23	    with open(args.config, encoding="utf-8") as handle:
    24	        config = json.load(handle)
    25	    codex_config = config.get("codexReview", {})
    26	    if not isinstance(codex_config, dict):
    27	        codex_config = {}
    28	    required_value = codex_config.get("required", False)
    29	    required = required_value is True
    30	    invalid_required = not isinstance(required_value, bool)
    31	
    32	    if not parse_bool(args.available):
    33	        result = {"action": "not-active", "state": "not-active",
    34	                  "promptVariant": None, "reason": args.available_reason}
    35	    elif args.mode == "full" and required:
    36	        result = {"action": "run", "state": None, "promptVariant": "full",
    37	                  "reason": "ready"}
    38	    elif args.mode == "full":
    39	        result = {"action": "skip", "state": "skipped-full-run",
    40	                  "promptVariant": None, "reason": "full-run-without-required"}
    41	    elif parse_bool(args.baseline_ok):
    42	        result = {"action": "run", "state": None, "promptVariant": "diff",
    43	                  "reason": "ready"}
    44	    else:
    45	        result = {"action": "skip", "state": "ref-invalid",
    46	                  "promptVariant": None, "reason": "baseline-ref-invalid"}
    47	
    48	    if invalid_required:
    49	        result["reason"] = "codexReview.required must be boolean"
    50	    if result["state"] is not None and result["state"] not in CODEX_REVIEW_STATES:
    51	        raise AssertionError("codex-review plan emitted an unknown state")
    52	    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    53	    return 0
    54	
    55	
    56	if __name__ == "__main__":
    57	    raise SystemExit(main())

---CODEX PROBE---
     1	#!/usr/bin/env bash
     2	# codex-probe.sh — Phase-0 preflight: detect the `codex` CLI (plain `codex exec`,
     3	# no plugin dependency) for docaudit's Phase-4 adversarial Codex review seam
     4	# (ax-pattern: conditional-force). If codex is present, bind
     5	# CODEX_REVIEW_AVAILABLE/CODEX_REVIEW_BIN so Phase 4 may run a Codex review. If
     6	# codex is absent / disabled, emit codexReviewAvailable:false and let the audit
     7	# continue unaffected — codex being unavailable is never a FAIL reason (though a
     8	# *completed* codex review's critical/high findings can be, per spec §5.4).
     9	#
    10	# NOTE: no `set -e` — failures are handled explicitly; we ALWAYS emit JSON + exit 0.
    11	# NOTE: no network use — `codex --version` and `codex exec --help` inspect only the
    12	# local binary and do not start a model invocation.
    13	set -uo pipefail
    14	
    15	CONFIG=""; REPO_ROOT="$(pwd)"
    16	while [[ $# -gt 0 ]]; do
    17	  case "$1" in
    18	    --config) CONFIG="$2"; shift 2;;
    19	    --repo-root) REPO_ROOT="$2"; shift 2;;
    20	    *) echo "unknown arg: $1" >&2; exit 2;;
    21	  esac
    22	done
    23	
    24	# codexReview.enabled (default true) + codexReview.bin (default "codex"); tolerate a
    25	# missing/invalid config by falling back to defaults.
    26	ENABLED="1"; BIN="codex"
    27	if [[ -n "$CONFIG" ]]; then
    28	  IFS=$'\t' read -r ENABLED BIN < <(python3 -c '
    29	import json,sys
    30	e=True; b="codex"
    31	try:
    32	    w=(json.load(open(sys.argv[1])).get("codexReview") or {})
    33	    e=bool(w.get("enabled",True)); b=str(w.get("bin","codex") or "codex")
    34	except Exception:
    35	    pass
    36	print(("1" if e else "0")+"\t"+b)
    37	' "$CONFIG")
    38	fi
    39	[[ -n "$BIN" ]] || BIN="codex"
    40	[[ -n "$ENABLED" ]] || ENABLED="1"
    41	# JSON-safe copy of BIN for echoing into the JSON (BIN comes from user config).
    42	BIN_J="$(printf '%s' "$BIN" | tr -d '"\\' | tr -d '[:cntrl:]')"
    43	
    44	if [[ "$ENABLED" != "1" ]]; then
    45	  printf '{"codexReviewAvailable":false,"codexReviewBin":"%s","codexReviewVersion":null,"probeCommands":[],"reason":"disabled-by-config"}\n' "$BIN_J"
    46	  exit 0
    47	fi
    48	
    49	if ! command -v "$BIN" >/dev/null 2>&1; then
    50	  printf '{"codexReviewAvailable":false,"codexReviewBin":"%s","codexReviewVersion":null,"probeCommands":[],"reason":"not-installed"}\n' "$BIN_J"
    51	  exit 0
    52	fi
    53	
    54	# `codex --version` reports the local binary version only — no network call.
    55	VERSION="$("$BIN" --version 2>/dev/null | tr -d '\r' | head -n1)"
    56	VERSION_J="$(printf '%s' "$VERSION" | tr -d '"\\' | tr -d '[:cntrl:]')"
    57	if ! "$BIN" exec --help >/dev/null 2>&1; then
    58	  printf '{"codexReviewAvailable":false,"codexReviewBin":"%s","codexReviewVersion":"%s","probeCommands":["%s --version","%s exec --help"],"reason":"probe-exec-failed"}\n' "$BIN_J" "$VERSION_J" "$BIN_J" "$BIN_J"
    59	  exit 0
    60	fi
    61	printf '{"codexReviewAvailable":true,"codexReviewBin":"%s","codexReviewVersion":"%s","probeCommands":["%s --version","%s exec --help"],"reason":"ok"}\n' "$BIN_J" "$VERSION_J" "$BIN_J" "$BIN_J"
    62	exit 0

