+    # PLAN §1.6 (v)
+    def test_v_fresh_run_base_mode_state_symlink_and_existing_lock(self):
+        config = {"docGlobs": ["docs/**/*.md"], "impactMap": []}
+
+        root = self.make_repo(config=config)
+        proc = self.invoke(root, "--write", *self.expected(root))
