diff --git a/skills/audit/scripts/import-audit-scope.py b/skills/audit/scripts/import-audit-scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..0728aa11735d0977ac27f2377bbd3a5360cc2447
--- /dev/null
+++ b/skills/audit/scripts/import-audit-scope.py
@@ -0,0 +1,287 @@
+#!/usr/bin/env python3
+"""Import a constrained audit-scope.json into doc-audit.json deterministically."""
+import argparse
+import collections
+import datetime
+import fcntl
+import fnmatch
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+from docaudit_paths import list_doc_files, matches_glob, validate_repo_path
+
+CATCH_ALL = {"*", "**", "**/*"}
+SHA = re.compile(r"^[0-9a-f]{64}$")
+
+
+class JSONObject(list):
+    """A JSON object retaining pairs so duplicate keys are observable."""
+
+
+def digest(raw):
+    return "sha256:" + hashlib.sha256(raw).hexdigest()
+
+
+def read_bytes(path):
+    with open(path, "rb") as handle:
+        return handle.read()
+
+
+def parse_json(raw, label, errors):
+    try:
+        return json.loads(raw.decode("utf-8"), object_pairs_hook=JSONObject)
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        errors.append(f"{label} is not valid JSON: {exc}")
+        return None
+
+
+def normal_object(value):
+    if isinstance(value, JSONObject):
+        return {key: normal_object(item) for key, item in value}
+    if isinstance(value, list):
+        return [normal_object(item) for item in value]
+    return value
+
+
+def config_object(raw, errors):
+    if raw is None:
+        return {}
+    parsed = parse_json(raw, "config", errors)
+    if parsed is not None and not isinstance(parsed, JSONObject):
+        errors.append("config top level must be an object")
+        return {}
+    return normal_object(parsed or [])
+
+
+def scope_rules(raw, errors):
+    parsed = parse_json(raw, "scope", errors)
+    if parsed is None:
+        return []
+    if not isinstance(parsed, JSONObject):
+        errors.append("scope top level must be an object")
+        return []
+    seen, rules = set(), []
+    for key, value in parsed:
+        if key in seen:
+            errors.append(f"duplicate scope rule: {key}")
+        seen.add(key)
+        rules.append((key, value))
+    return rules
+
+
+def convert(pattern, errors):
+    if not isinstance(pattern, str) or not pattern:
+        errors.append(f"invalid scope rule: {pattern!r}"); return None
+    if pattern in CATCH_ALL:
+        errors.append(f"bare catch-all is not allowed: {pattern}"); return None
+    if "\r" in pattern or "\n" in pattern:
+        errors.append(f"CR/LF in scope rule: {pattern!r}"); return None
+    if pattern.startswith("./") or pattern.endswith("/") or "?" in pattern or "[" in pattern:
+        errors.append(f"unsupported fnmatch syntax: {pattern}"); return None
+    converted = re.sub(r"\*+", "**", pattern)
+    if "**/" in converted:
+        errors.append(f"unsupported slash after wildcard: {pattern}"); return None
+    if converted in CATCH_ALL:
+        errors.append(f"bare catch-all is not allowed: {pattern}"); return None
+    return converted
+
+
+def metadata(config, repo, errors):
+    value = config.get("auditScope")
+    if value is None:
+        return None
+    if not isinstance(value, dict):
+        errors.append("auditScope must be an object"); return None
+    path, sha, rules, imported = (value.get(k) for k in ("path", "sha256", "rules", "importedAt"))
+    try:
+        path = validate_repo_path(repo, path, must_exist=False)
+    except ValueError as exc:
+        errors.append(f"auditScope.path invalid: {exc}")
+    if not isinstance(sha, str) or not SHA.fullmatch(sha): errors.append("auditScope.sha256 invalid")
+    if isinstance(rules, bool) or not isinstance(rules, int) or rules < 0: errors.append("auditScope.rules invalid")
+    if not isinstance(imported, str): errors.append("auditScope.importedAt invalid")
+    return value
+
+
+def report_regex(config):
+    # Match the same report template language used by resolve-impact.
+    value = config.get("reportPath")
+    if not isinstance(value, str) or not value.endswith(".md"):
+        return None
+    name = os.path.basename(value)
+    if "<YYYY-MM-DD>" not in name or not name.split("<YYYY-MM-DD>", 1)[0]: return None
+    escaped = re.escape(value).replace(re.escape("<YYYY-MM-DD>"), r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
+    escaped = escaped.replace(re.escape("[_NN]"), r"(_[0-9]{2,})?")
+    return re.compile("^" + escaped + "$")
+
+
+def validate_rules(rules, repo, config, doc_globs, errors):
+    translated, skipped = [], []
+    corpus = set(list_doc_files(repo, doc_globs))
+    rx = None if config.get("auditReportsInCorpus") is True else report_regex(config)
+    for changed, value in rules:
+        converted = convert(changed, errors)
+        value = normal_object(value)
+        if isinstance(value, dict):
+            if value == {"impact": "none"}:
+                if converted: skipped.append(changed)
+                continue
+            errors.append(f"invalid scope value: {changed}"); continue
+        if not isinstance(value, list) or not value:
+            errors.append(f"scope impacts must be a non-empty string array: {changed}"); continue
+        impacts = []
+        for target in value:
+            if not isinstance(target, str): errors.append(f"scope impact is not a string: {changed}"); continue
+            if "\r" in target or "\n" in target: errors.append(f"CR/LF in scope impact: {changed}"); continue
+            try: target = validate_repo_path(repo, target)
+            except ValueError as exc: errors.append(f"invalid scope impact {changed}: {exc}"); continue
+            if not any(matches_glob(target, glob) for glob in doc_globs):
+                errors.append(f"scope impact outside docGlobs ({target}); extend docGlobs and rerun"); continue
+            if target not in corpus or (rx and rx.fullmatch(target)):
+                errors.append(f"scope impact outside document corpus ({target}); extend docGlobs and rerun"); continue
+            impacts.append(target)
+        if converted and impacts:
+            translated.append({"changed": converted, "impacts": impacts, "from": changed})
+    return translated, skipped
+
+
+def git_paths(repo, errors):
+    paths = set()
+    for command in (("git", "ls-files", "-z"), ("git", "ls-files", "-z", "--others", "--exclude-standard")):
+        try:
+            raw = subprocess.run(command, cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True).stdout
+        except (OSError, subprocess.CalledProcessError) as exc:
+            errors.append(f"git enumeration failed: {exc}"); return []
+        for item in raw.decode("utf-8", "surrogateescape").split("\0"):
+            if not item: continue
+            if "\r" in item or "\n" in item: errors.append(f"unsupported filename: {item!r}")
+            else: paths.add(item)
+    if not paths: errors.append("git enumeration returned zero paths")
+    return sorted(paths)
+
+
+def equivalence(rules, paths, errors):
+    for original, _ in rules:
+        converted = convert(original, errors)
+        if not converted: continue
+        left = {p for p in paths if fnmatch.fnmatchcase(p, original)}
+        right = {p for p in paths if matches_glob(p, converted)}
+        if left != right:
+            diff = sorted(left ^ right)[:3]
+            errors.append(f"glob equivalence mismatch {original}: {diff}")
+
+
+def result(state, rules, translated, skipped, errors, checked, config_raw, scope_raw, missing=(), extra=()):
+    return {"state": state, "rules": len(rules), "translated": translated,
+            "skippedNoImpact": skipped, "errors": errors, "equivalenceChecked": checked,
+            "configSha": digest(config_raw) if config_raw is not None else "none",
+            "scopeSha": digest(scope_raw) if scope_raw is not None else None,
+            "diff": {"missing": list(missing), "extra": list(extra)}}
+
+
+def compare(config, translated):
+    want = collections.Counter((x["changed"], tuple(x["impacts"])) for x in translated)
+    got = collections.Counter((x.get("changed"), tuple(x.get("impacts", []))) for x in config.get("impactMap", []) if isinstance(x, dict) and x.get("source") == "audit-scope")
+    return list((want - got).elements()), list((got - want).elements())
+
+
+def safe_path(repo, path, errors, label):
+    try: return validate_repo_path(repo, path, must_exist=False)
+    except ValueError as exc: errors.append(f"{label} invalid: {exc}"); return None
+
+
+def acquire(repo):
+    base = os.path.join(repo, ".claude", "state", "docaudit-run")
+    for part in (os.path.join(repo, ".claude"), os.path.join(repo, ".claude", "state"), base):
+        if os.path.lexists(part) and os.path.islink(part): raise ValueError(f"run-base symlink: {part}")
+        if not os.path.exists(part): os.mkdir(part, 0o700)
+    lock = os.path.join(base, "lock")
+    try: fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_RDWR, 0o600)
+    except FileExistsError: return None, lock
+    try:
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        if os.fstat(fd).st_ino != os.lstat(lock).st_ino: raise RuntimeError("lock inode changed")
+        os.write(fd, json.dumps({"owner":"import-audit-scope","runid":None,"startedAt":datetime.datetime.now(datetime.UTC).isoformat()}).encode())
+        return fd, lock
+    except Exception:
+        os.close(fd)
+        if os.path.exists(lock): os.unlink(lock)
+        raise
+
+
+def release(fd, lock):
+    if fd is None: return
+    try:
+        if os.fstat(fd).st_ino == os.lstat(lock).st_ino: os.unlink(lock)
+    except FileNotFoundError: pass
+    finally:
+        fcntl.flock(fd, fcntl.LOCK_UN); os.close(fd)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--repo-root", default=os.getcwd()); ap.add_argument("--config", default=".claude/doc-audit.json")
+    ap.add_argument("--scope", default=".claude/audit-scope.json"); ap.add_argument("--doc-glob", action="append", default=[])
+    mode = ap.add_mutually_exclusive_group(); mode.add_argument("--check", action="store_true"); mode.add_argument("--write", action="store_true")
+    ap.add_argument("--json", action="store_true"); ap.add_argument("--expect-config-sha"); ap.add_argument("--expect-scope-sha")
+    ap.add_argument("--base-config"); ap.add_argument("--expect-base-config-sha")
+    args = ap.parse_args(); args.check = not args.write
+    repo = os.path.realpath(args.repo_root); errors=[]
+    config_rel=safe_path(repo,args.config,errors,"config"); scope_rel=safe_path(repo,args.scope,errors,"scope")
+    if args.write and (not args.expect_scope_sha or (args.base_config is None and args.expect_config_sha is None)):
+        errors.append("--write requires expected config and scope SHA")
+    config_path=os.path.join(repo,config_rel) if config_rel else ""; scope_path=os.path.join(repo,scope_rel) if scope_rel else ""
+    config_raw=read_bytes(config_path) if config_rel and os.path.isfile(config_path) else None
+    config=config_object(config_raw,errors); meta=metadata(config,repo,errors)
+    scope_exists=bool(scope_rel and os.path.isfile(scope_path))
+    if not scope_exists and meta is None and not errors:
+        out=result("absent",[],[],[],[],0,config_raw,None); print(json.dumps(out,ensure_ascii=False) if args.json else "audit scope: absent"); return 0
+    if errors:
+        out=result("error",[],[],[],errors,0,config_raw,None); print(json.dumps(out,ensure_ascii=False) if args.json else "\n".join(errors)); return 1
+    if not scope_exists:
+        out=result("drift",[],[],[],[],0,config_raw,None); print(json.dumps(out,ensure_ascii=False) if args.json else "audit scope: drift"); return 2
+    scope_raw=read_bytes(scope_path); rules=scope_rules(scope_raw,errors)
+    globs=config.get("docGlobs", args.doc_glob or ["docs/**/*.md", "*.md"])
+    if not isinstance(globs,list) or not all(isinstance(x,str) for x in globs): errors.append("docGlobs must be a string array")
+    translated,skipped=validate_rules(rules,repo,config,globs if isinstance(globs,list) else [],errors)
+    paths=git_paths(repo,errors); equivalence(rules,paths,errors)
+    if errors:
+        out=result("error",rules,translated,skipped,errors,len(paths),config_raw,scope_raw); print(json.dumps(out,ensure_ascii=False) if args.json else "\n".join(errors)); return 1
+    missing,extra=compare(config,translated)
+    if not args.write:
+        state="not-imported" if meta is None else ("in-sync" if not missing and not extra and meta.get("sha256")==digest(scope_raw)[7:] and meta.get("path")==scope_rel else "drift")
+        out=result(state,rules,translated,skipped,[],len(paths),config_raw,scope_raw,missing,extra); print(json.dumps(out,ensure_ascii=False) if args.json else f"audit scope: {state}"); return 0 if state in ("absent","in-sync") else 2
+    fd=lock=None
+    try:
+        fd,lock=acquire(repo)
+        if fd is None: return 3
+        fresh=read_bytes(config_path) if os.path.isfile(config_path) else None
+        base=sys.stdin.buffer.read() if args.base_config == "-" else None
+        if args.base_config == "-" and fresh is not None: errors.append("config already exists")
+        expected = digest(base) if base is not None else (digest(fresh) if fresh is not None else "none")
+        if (args.base_config == "-" and args.expect_base_config_sha != expected) or (args.base_config != "-" and args.expect_config_sha != expected) or args.expect_scope_sha != digest(read_bytes(scope_path)):
+            return 4
+        final=config_object(base if base is not None else fresh,errors)
+        if errors: return 1
+        final["impactMap"]=[x for x in final.get("impactMap",[]) if not(isinstance(x,dict) and x.get("source")=="audit-scope")]
+        final["impactMap"].extend({"changed":x["changed"],"impacts":x["impacts"],"source":"audit-scope","note":f"generated from {scope_rel}"} for x in translated)
+        final["auditScope"]={"path":scope_rel,"sha256":digest(scope_raw)[7:],"importedAt":datetime.datetime.now(datetime.UTC).isoformat(),"rules":len(rules)}
+        directory=os.path.dirname(config_path); os.makedirs(directory,exist_ok=True)
+        temp=tempfile.NamedTemporaryFile("w",encoding="utf-8",dir=directory,delete=False)
+        try:
+            json.dump(final,temp,ensure_ascii=False,indent=2); temp.write("\n"); temp.close(); os.replace(temp.name,config_path)
+            dfd=os.open(directory,os.O_RDONLY); os.fsync(dfd); os.close(dfd)
+        finally:
+            if not temp.closed: temp.close()
+            if os.path.exists(temp.name): os.unlink(temp.name)
+    except ValueError as exc:
+        print(str(exc),file=sys.stderr); return 1
+    finally: release(fd,lock)
+    return 0
+
+if __name__ == "__main__": sys.exit(main())
