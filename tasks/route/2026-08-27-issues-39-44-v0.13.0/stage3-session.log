index 0000000000000000000000000000000000000000..2f7c6dca7d38d7eef8328b63902e31ada023d9f3
--- /dev/null
+++ b/tests/test_import_audit_scope.py
@@ -0,0 +1,57 @@
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SCRIPT = os.path.join(ROOT, "skills", "audit", "scripts", "import-audit-scope.py")
+
+
+class ImportAuditScopeTests(unittest.TestCase):
+    def repo(self, scope='{"src/*.py":["docs/a.md"]}'):
+        temp = tempfile.TemporaryDirectory(); root = temp.name
+        os.makedirs(os.path.join(root, ".claude")); os.makedirs(os.path.join(root, "docs"))
+        with open(os.path.join(root, "docs", "a.md"), "w") as handle: handle.write("# a\n")
+        with open(os.path.join(root, ".claude", "audit-scope.json"), "w") as handle: handle.write(scope)
+        os.makedirs(os.path.join(root, "src"))
+        with open(os.path.join(root, "src", "x.py"), "w") as handle: handle.write("")
+        subprocess.run(["git", "init", "-q"], cwd=root, check=True)
+        subprocess.run(["git", "add", "."], cwd=root, check=True)
+        return temp, root
+
+    def invoke(self, root, *args):
+        return subprocess.run([sys.executable, SCRIPT, "--repo-root", root, *args], text=True, capture_output=True)
+
+    def test_absent_does_not_require_git(self):
+        with tempfile.TemporaryDirectory() as root:
+            os.makedirs(os.path.join(root, ".claude"))
+            proc = self.invoke(root, "--json")
+            self.assertEqual(proc.returncode, 0, proc.stderr)
+            self.assertEqual(json.loads(proc.stdout)["state"], "absent")
+
+    def test_check_write_and_multiset_drift(self):
+        temp, root = self.repo()
+        with temp:
+            proc = self.invoke(root, "--json")
+            self.assertEqual(json.loads(proc.stdout)["state"], "not-imported")
+            config = os.path.join(root, ".claude", "doc-audit.json")
+            with open(config, "w") as handle: handle.write('{"docGlobs":["docs/**/*.md"],"impactMap":[]}')
+            with open(config, "rb") as handle: raw = handle.read()
+            with open(os.path.join(root, ".claude", "audit-scope.json"), "rb") as handle: scope = handle.read()
+            proc = self.invoke(root, "--write", "--expect-config-sha", "sha256:" + hashlib.sha256(raw).hexdigest(), "--expect-scope-sha", "sha256:" + hashlib.sha256(scope).hexdigest())
+            self.assertEqual(proc.returncode, 0, proc.stderr)
+            with open(config) as handle: data = json.load(handle)
+            data["impactMap"].append(data["impactMap"][0])
+            with open(config, "w") as handle: json.dump(data, handle)
+            self.assertEqual(json.loads(self.invoke(root, "--json").stdout)["state"], "drift")
+
+    def test_rejects_unsupported_patterns_and_invalid_values(self):
+        for scope in ('{"*/foo":["docs/a.md"]}', '{"x.py":{"impact":"yes"}}', '{"x.py":[]}'):
+            temp, root = self.repo(scope)
+            with temp: self.assertEqual(self.invoke(root, "--json").returncode, 1)
+
+
+if __name__ == "__main__": unittest.main()
