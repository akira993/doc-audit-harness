    48	def list_doc_files(repo_root, doc_globs, report_rx=None):
    49	    skip = {".git", ".hg", ".svn", "node_modules", ".venv", "venv", "__pycache__", "dist", "build"}
    50	    regexes = [glob_to_regex(g) for g in doc_globs]
    51	    docs = []
    52	    for dp, dirs, files in os.walk(repo_root):
    53	        dirs[:] = [d for d in dirs if d not in skip]  # prune .git/node_modules/etc
    54	        for fn in files:
    55	            rel = os.path.relpath(os.path.join(dp, fn), repo_root)
    56	            if any(rx.match(rel) for rx in regexes) and not (report_rx and re.fullmatch(report_rx, rel)):
    57	                docs.append(rel)
    58	    return sorted(docs)
