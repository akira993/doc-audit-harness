    71	def list_doc_files(repo_root, doc_globs):
    72	    skip = {".git", ".hg", ".svn", "node_modules", ".venv", "venv", "__pycache__", "dist", "build"}
    73	    docs = []
    74	    regexes = [glob_to_regex(g) for g in doc_globs]
    75	    # followlinks=False (default): symlinked doc trees are not traversed
    76	    for dirpath, dirs, files in os.walk(repo_root):
    77	        dirs[:] = [d for d in dirs if d not in skip]  # prune .git/node_modules/etc
    78	        # prune nested checkouts: a subdir containing a .git entry (dir for a
    79	        # nested clone/submodule, file for a linked worktree's `gitdir: ...`
    80	        # pointer) is a separate checkout and must not be walked into. The
    81	        # walk root itself is exempt: this only filters dirs we'd descend
    82	        # into next, never the current dirpath.
    83	        dirs[:] = [d for d in dirs if not os.path.exists(os.path.join(dirpath, d, ".git"))]
    84	        for fn in files:
    85	            full = os.path.join(dirpath, fn)
    86	            rel = os.path.relpath(full, repo_root)
    87	            if any(rx.match(rel) for rx in regexes):
    88	                docs.append(rel)
    89	    return docs
