    87	def release(lock_path, runid, breaking=False):
    88	    try:
    89	        fd = os.open(lock_path, os.O_RDWR | os.O_NOFOLLOW)
    90	    except FileNotFoundError:
    91	        return emit({"released": False, "reason": "lock-missing"}, 0 if breaking else 4)
    92	    except OSError as exc:
    93	        print(f"open-run: cannot safely open lock: {exc}", file=sys.stderr)
    94	        return 4
    95	    try:
    96	        try:
    97	            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    98	        except BlockingIOError:
    99	            return emit({"released": False, "reason": "gate-running", "holder": read_holder(fd)}, 4)
   100	        before = os.fstat(fd).st_ino
   101	        try:
   102	            after = os.stat(lock_path, follow_symlinks=False).st_ino
   103	        except FileNotFoundError:
   104	            return emit({"released": False, "reason": "lock-replaced"}, 4)
   105	        holder = read_holder(fd)
   106	        if before != after:
   107	            return emit({"released": False, "reason": "lock-replaced", "holder": holder}, 4)
   108	        if not breaking and holder.get("runid") != runid:
   109	            return emit({"released": False, "reason": "runid-mismatch", "holder": holder}, 4)
   110	        os.unlink(lock_path)
   111	        return emit({"released": True, "broken": breaking, "holder": holder})
   112	    finally:
   113	        os.close(fd)
