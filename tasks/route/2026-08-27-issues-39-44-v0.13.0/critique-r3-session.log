     8	def glob_to_regex(pattern):
     9	    out = []
    10	    i = 0
    11	    while i < len(pattern):
    12	        char = pattern[i]
    13	        if char == "*":
    14	            if i + 1 < len(pattern) and pattern[i + 1] == "*":
    15	                if i + 2 < len(pattern) and pattern[i + 2] == "/":
    16	                    out.append("(?:.*/)?")
    17	                    i += 3
    18	                else:
    19	                    out.append(".*")
    20	                    i += 2
    21	            else:
    22	                out.append("[^/]*")
    23	                i += 1
    24	        elif char == "?":
    25	            out.append("[^/]")
    26	            i += 1
    27	        else:
    28	            out.append(re.escape(char))
    29	            i += 1
    30	    return re.compile("^" + "".join(out) + "$")
