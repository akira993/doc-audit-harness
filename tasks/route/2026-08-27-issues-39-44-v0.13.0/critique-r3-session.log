    45	def glob_to_regex(pattern):
    46	    """`**` -> any incl '/', `*` -> any except '/', `?` -> single except '/'."""
    47	    out, i, n = [], 0, len(pattern)
    48	    while i < n:
    49	        c = pattern[i]
    50	        if c == "*":
    51	            if i + 1 < n and pattern[i + 1] == "*":
    52	                if i + 2 < n and pattern[i + 2] == "/":
    53	                    out.append("(.*/)?"); i += 3
    54	                else:
    55	                    out.append(".*"); i += 2
    56	            else:
    57	                out.append("[^/]*"); i += 1
    58	        elif c == "?":
    59	            out.append("[^/]"); i += 1
    60	        else:
    61	            out.append(re.escape(c)); i += 1
    62	    return re.compile("^" + "".join(out) + "$")
