    68	def list_doc_files(repo_root, doc_globs, warnings=None):
    69	    root = os.path.realpath(repo_root)
    70	    skip = {".git", ".hg", ".svn", "node_modules", ".venv", "venv",
    71	            "__pycache__", "dist", "build"}
    72	    found = []
    73	    for dirpath, dirs, files in os.walk(root, followlinks=False):
    74	        kept_dirs = []
    75	        for name in dirs:
    76	            full_dir = os.path.join(dirpath, name)
    77	            if name in skip or os.path.exists(os.path.join(full_dir, ".git")):
    78	                continue
    79	            if os.path.islink(full_dir):
    80	                if warnings is not None:
    81	                    rel = os.path.relpath(full_dir, root).replace(os.sep, "/")
    82	                    warnings.append(f"document directory dropped as unsafe: {rel} (symlink)")
    83	                continue
    84	            kept_dirs.append(name)
    85	        dirs[:] = kept_dirs
    86	        for name in files:
    87	            full = os.path.join(dirpath, name)
    88	            rel = os.path.relpath(full, root).replace(os.sep, "/")
    89	            if not any(matches_glob(rel, glob) for glob in doc_globs):
    90	                continue
    91	            try:
    92	                found.append(validate_repo_path(root, rel))
    93	            except ValueError as exc:
    94	                if warnings is not None:
    95	                    warnings.append(f"document path dropped as unsafe: {rel} ({exc})")
    96	                continue
    97	    return sorted(set(found))
