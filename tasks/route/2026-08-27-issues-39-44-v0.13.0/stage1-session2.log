+    @staticmethod
+    def _semver_key(version):
+        match = re.fullmatch(r"(\d+)\.(\d+)\.(\d+)", version)
+        if not match:
+            raise AssertionError(f"non-semver engine-shas key: {version}")
+        return tuple(int(part) for part in match.groups())
