+        whitespace_width = whitespace_end - marker_end
+        content_indent = marker_end + (1 if whitespace_width >= 5 else whitespace_width)
+        rest = rest[item.end():]
+        column = whitespace_end
+        innermost = (content_indent, rest)
+
