+PLUGIN = os.path.join(ROOT, ".claude-plugin", "plugin.json")
+SHAS = os.path.join(ROOT, "skills", "audit", "references", "engine-shas.json")
+SCAFFOLD = os.path.join(ROOT, "skills", "audit", "scripts", "scaffold.py")
