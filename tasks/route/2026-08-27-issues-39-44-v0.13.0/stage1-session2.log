multiline = module.extract_bare_paths('[text\\nmore\\ntext](docs/link.md)\\ndocs/revert-link.md\\n')
assert ('docs/revert-list.md', 2) in continuation, continuation
assert ('docs/revert-link.md', 4) in multiline, multiline
print('1.1 green:', continuation)
print('1.2 green:', multiline)
