+            "layer": "existence",
+            "severity": "WARN",
+            "path": "docs/a.md",
+            "line": 6,
+            "message": "bare path reference does not resolve: docs/after-link.md",
+        }])
+
+    def test_token_base_dead_code_is_absent(self):
+        self.assertFalse(hasattr(load_script_module(), "_token_base"))
