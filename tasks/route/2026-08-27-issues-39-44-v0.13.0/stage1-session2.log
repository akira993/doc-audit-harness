+def _advance_columns(text, column=0):
+    for char in text:
+        column = column + (4 - column % 4) if char == "\t" else column + 1
+    return column
+
+
+def _strip_blockquote_markers(line):
+    rest = line
+    while True:
+        blockquote = re.match(r"^ {0,3}>[ \t]?", rest)
+        if not blockquote:
+            return rest
+        rest = rest[blockquote.end():]
+
