+        with open(fx.anchor, "rb") as handle:
+            self.assertEqual(handle.read(), anchor_before)
+        with open(fx.last_run, encoding="utf-8") as handle:
+            last_run = json.load(handle)
+        self.assertEqual(last_run["verdict"], "REFUSED")
