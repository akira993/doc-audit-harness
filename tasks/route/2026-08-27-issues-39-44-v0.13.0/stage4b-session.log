+                proc = fx.gate()
+                self.assertEqual(proc.returncode, 3, proc.stdout + proc.stderr)
+                self.assertEqual(json.loads(proc.stdout)["reason"], reason)
+
+    def test_codex_review_evidence_shape_is_always_strict(self):
