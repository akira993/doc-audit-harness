+                self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+                with open(os.path.join(fx.run_dir, "manifest.json"),
+                          encoding="utf-8") as handle:
+                    manifest = json.load(handle)
+                self.assertTrue(manifest["phase4Required"])
+
+
