+        self.assertNotIn("codex-review", json.dumps(anchor))
+
+    def test_optional_ref_invalid_warns_without_refusing(self):
+        fx = self.prepared_codex(
+            {}, {"findings": [], "codexReview": {"state": "ref-invalid"}})
+        proc = fx.gate()
