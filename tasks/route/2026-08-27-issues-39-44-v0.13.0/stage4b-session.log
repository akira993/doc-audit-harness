+            (["completed"], "codexReview must be an object"),
+            ({"state": 7}, "state must be a string"),
+            ({"state": "future-state"}, "state is not recognized"),
+        ]
+        for evidence, detail in cases:
+            with self.subTest(detail=detail):
+                fx = self.prepared_codex(
