    92	def prompt_for(manifest, repo, path, provenance):
    93	    identity = json.dumps({"runid": manifest["runid"], "path": path},
    94	                          ensure_ascii=False, sort_keys=True)
    95	    head = manifest.get("head")
    96	    if manifest.get("mode") == "full":
    97	        scope = f"""This is a full-corpus audit. There is no diff scope.
    98	Sealed HEAD: {head}
    99	
   100	Investigate whether the document at {json.dumps(path, ensure_ascii=False)} accurately describes
   101	the current source and configuration at the sealed HEAD."""
   102	        fail_basis = "the current source"
   103	        pass_basis = "the document accurately describes the current source and configuration"
   104	    else:
   105	        changed_set = manifest.get("changedSet", [])
   106	        shown = changed_set[:MAX_CHANGED_PATHS_IN_PROMPT]
   107	        changed_paths = "\n".join(
   108	            f"- {json.dumps(item, ensure_ascii=False)}" for item in shown)
   109	        if not changed_paths:
   110	            changed_paths = "- (none)"
   111	        scope = f"""Baseline commit: {manifest.get("baselineSha")}
   112	Sealed HEAD: {head}
   113	Sealed changed paths: {len(changed_set)} total; showing {len(shown)}:
   114	{changed_paths}
   115	
   116	Investigate whether the document at {json.dumps(path, ensure_ascii=False)} still accurately
   117	describes the source/configuration changes between the baseline and sealed HEAD. The verification
   118	target is the current file content in the sealed worktree. The changed set may include uncommitted
   119	and untracked changes: do not rely only on commit history. Compare the document's claims with the
   120	current content of the listed changed paths."""
   121	        fail_basis = "the changed source"
   122	        pass_basis = "the document is unaffected or already consistent"
   123	    return f"""You are a report-only documentation-impact verifier for exactly one document.
   124	Repository root: {repo}
   125	Expected identity JSON: {identity}
   126	Impact provenance: {provenance}
   127	{scope} Use read-only commands only. Use grep -n and narrowly targeted reads for relevant document and source lines.
   128	Do not use mdq even if it is installed, and do not read unrelated files.
   129	
   130	Choose exactly one verdict:
   131	- FAIL: a cited document claim is contradicted by {fail_basis}.
   132	- WARN: there is a concrete, cited staleness or under-specification signal.
   133	- PASS: {pass_basis}.
   134	
   135	Return only JSON conforming to the supplied schema. The runid and path must exactly equal the
   136	Expected identity JSON. Give a concise rationale citing file:line and put supporting file:line
   137	references in the evidence array. Do not edit any file.
   138	"""
