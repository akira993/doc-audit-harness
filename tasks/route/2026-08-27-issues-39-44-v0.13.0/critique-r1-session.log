    47	def load_manifest(run_dir, repo):
    48	    with open(os.path.join(run_dir, "manifest.json"), encoding="utf-8") as handle:
    49	        manifest = json.load(handle)
    50	    if not isinstance(manifest, dict) or manifest.get("sealed") is not True:
    51	        raise ValueError("manifest must be a sealed object")
    52	    runid = manifest.get("runid")
    53	    dispatched = manifest.get("dispatch")
    54	    cached = manifest.get("cached")
    55	    changed_set = manifest.get("changedSet")
    56	    if (not isinstance(runid, str) or not runid
    57	            or not isinstance(dispatched, list) or not isinstance(cached, list)
    58	            or not isinstance(changed_set, list)
    59	            or any(not isinstance(path, str) for path in dispatched + cached)
    60	            or any(not isinstance(path, str) for path in changed_set)
    61	            or len(dispatched) != len(set(dispatched))
    62	            or set(dispatched) & set(cached)):
    63	        raise ValueError("manifest dispatch identity is invalid")
    64	    return manifest, [validate_repo_path(repo, path) for path in dispatched]
