    16	def atomic_write(path, raw):
    17	    fd, temporary = tempfile.mkstemp(prefix=".manifest.", dir=os.path.dirname(path))
    18	    try:
    19	        with os.fdopen(fd, "wb") as handle:
    20	            handle.write(raw)
    21	            handle.flush()
    22	            os.fsync(handle.fileno())
    23	        os.replace(temporary, path)
    24	    finally:
