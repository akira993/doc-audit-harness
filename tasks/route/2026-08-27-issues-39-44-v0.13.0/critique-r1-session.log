   252	def validate_evidence(value):
   253	    if not isinstance(value, dict):
   254	        raise Refused("EVIDENCE is not an object")
   255	    if REQUIRED_EXPECT - set(value):
   256	        raise Refused("EVIDENCE required keys are missing")
   257	    if not isinstance(value["runid"], str) or not isinstance(value["runDir"], str):
   258	        raise Refused("EVIDENCE run identity has invalid types")
   259	    if (isinstance(value["lockIno"], bool) or not isinstance(value["lockIno"], int)
   260	            or value["lockIno"] <= 0):
   261	        raise Refused("EVIDENCE lockIno has invalid type")
   262	    if (isinstance(value["attempt"], bool) or not isinstance(value["attempt"], int)
   263	            or not 0 <= value["attempt"] <= 3):
   264	        raise Refused("EVIDENCE attempt has invalid type")
   265	    if value["historyStatus"] not in {"absent", "ok", "corrupt"}:
   266	        raise Refused("EVIDENCE historyStatus is invalid")
   267	    sha_fields = {"config", "dispatch", "manifest", "digest", "returns"}
   268	    optional_sha_fields = {"anchor", "preflight", "cached", "history", "phase4"}
   269	    sha_re = re.compile(r"^sha256:[0-9a-f]{64}$")
   270	    for key in sha_fields:
   271	        if not isinstance(value[key], str) or not sha_re.fullmatch(value[key]):
   272	            raise Refused(f"EVIDENCE {key} has invalid type")
   273	    for key in optional_sha_fields:
   274	        if not isinstance(value[key], str) or (value[key] != "none" and not sha_re.fullmatch(value[key])):
   275	            raise Refused(f"EVIDENCE {key} has invalid type")
