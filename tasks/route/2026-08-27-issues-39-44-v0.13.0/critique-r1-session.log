   133	            raise ValueError("run-base must be .claude/state/docaudit-run")
   134	        os.makedirs(run_base, exist_ok=True)
   135	    except (OSError, ValueError) as exc:
   136	        print(f"open-run: {exc}", file=sys.stderr)
   137	        return 2
   138	    lock_path = os.path.join(run_base, "lock")
   139	    if args.break_lock:
   140	        return release(lock_path, None, breaking=True)
   141	    if args.release:
   142	        if not args.runid or not RUNID_RE.match(args.runid):
   143	            print("open-run: --release requires a valid --runid", file=sys.stderr)
   144	            return 2
   145	        return release(lock_path, args.runid)
   146	
   147	    runid = args.runid or (datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ-") + secrets.token_hex(4))
   148	    if not RUNID_RE.match(runid):
   149	        print("open-run: invalid runid", file=sys.stderr)
   150	        return 2
   151	    try:
   152	        config_path = os.path.join(repo, validate_repo_path(repo, ".claude/doc-audit.json"))
   153	    except ValueError as exc:
   154	        print(f"open-run: invalid config path: {exc}", file=sys.stderr)
   155	        return 2
   156	    try:
   157	        with open(config_path, "rb") as handle:
   158	            config_bytes = handle.read()
   159	    except OSError as exc:
   160	        print(f"open-run: cannot read config: {exc}", file=sys.stderr)
   161	        return 2
   162	    config_sha = sha(config_bytes)
   163	    last_run_path = os.path.join(repo, ".claude", "state", "docaudit-last-run.json")
   164	    if os.path.isfile(last_run_path) and not args.accept_config:
   165	        try:
   166	            with open(last_run_path, encoding="utf-8") as handle:
   167	                last_run = json.load(handle)
   168	        except (OSError, json.JSONDecodeError):
   169	            last_run = {}
   170	        if (last_run.get("verdict") == "REFUSED"
   171	                and last_run.get("reason") == "config-changed"
   172	                and last_run.get("expectedConfigSha") != config_sha):
   173	            return emit({"opened": False, "reason": "config-change-unaccepted",
   174	                         "expectedConfigSha": last_run.get("expectedConfigSha")}, 6)
   175	    anchor_absolute = (args.anchor_path if os.path.isabs(args.anchor_path)
   176	                       else os.path.join(repo, args.anchor_path))
   177	    anchor_rel = os.path.relpath(os.path.abspath(anchor_absolute), repo).replace(os.sep, "/")
   178	    try:
   179	        anchor = os.path.join(
   180	            repo, validate_repo_path(repo, anchor_rel, must_exist=False, regular_file=False))
   181	        if os.path.lexists(anchor) and not os.path.isfile(anchor):
   182	            raise ValueError("anchor must be a regular file when present")
   183	    except ValueError as exc:
   184	        print(f"open-run: invalid anchor path: {exc}", file=sys.stderr)
   185	        return 2
   186	    if os.path.isfile(anchor):
   187	        with open(anchor, "rb") as handle:
   188	            anchor_sha = sha(handle.read())
   189	    else:
   190	        anchor_sha = "none"
   191	    holder = {"runid": runid, "startedAt": datetime.datetime.now(datetime.timezone.utc).isoformat()}
   192	    raw = (json.dumps(holder, sort_keys=True) + "\n").encode("utf-8")
   193	    try:
   194	        fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_RDWR | os.O_NOFOLLOW, 0o600)
   195	    except FileExistsError:
   196	        try:
   197	            existing_fd = os.open(lock_path, os.O_RDONLY | os.O_NOFOLLOW)
   198	            try:
   199	                existing = read_holder(existing_fd)
   200	            finally:
   201	                os.close(existing_fd)
   202	        except Exception:
   203	            existing = {"invalid": True}
   204	        return emit({"locked": True, "holder": existing}, 4)
   205	    try:
   206	        fcntl.flock(fd, fcntl.LOCK_EX)
   207	        os.write(fd, raw)
   208	        os.fsync(fd)
   209	        inode = os.fstat(fd).st_ino
   210	        run_dir = os.path.join(run_base, runid)
   211	        os.mkdir(run_dir, 0o700)
   212	    except Exception as exc:
   213	        try:
   214	            os.unlink(lock_path)
   215	        except OSError:
   216	            pass
   217	        print(f"open-run: {exc}", file=sys.stderr)
   218	        return 2
   219	    finally:
   220	        os.close(fd)
   221	    result = {"runid": runid, "runDir": run_dir, "anchor": anchor_sha,
   222	              "config": config_sha, "lockIno": inode,
   223	              "preflight": "none", "phase4": "none"}
   224	    prior_status = previous_report_status(last_run_path)
   225	    if prior_status is not None:
   226	        result["previousReportStatus"] = prior_status
   227	    return emit(result)
