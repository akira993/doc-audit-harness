    78	def private_directory(codex_root, attempt, path):
    79	    digest = hashlib.sha256(path.encode("utf-8")).hexdigest()[:16]
    80	    stem = f"attempt-{attempt:02d}-{digest}"
    81	    number = 1
    82	    while True:
    83	        name = stem if number == 1 else f"{stem}-{number:02d}"
    84	        candidate = os.path.join(codex_root, name)
    85	        try:
    86	            os.mkdir(candidate, 0o700)
    87	            return candidate
    88	        except FileExistsError:
    89	            number += 1
