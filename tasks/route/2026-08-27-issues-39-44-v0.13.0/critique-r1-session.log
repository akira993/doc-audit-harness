   141	def terminate_group(process):
   142	    try:
   143	        os.killpg(process.pid, signal.SIGTERM)
   144	    except ProcessLookupError:
   145	        pass
   146	    try:
   147	        process.communicate(timeout=KILL_GRACE_SECONDS)
   148	        return
   149	    except subprocess.TimeoutExpired:
   150	        pass
   151	    try:
   152	        os.killpg(process.pid, signal.SIGKILL)
   153	    except ProcessLookupError:
   154	        pass
   155	    process.communicate()

