    67	def load_provenance(run_dir):
    68	    try:
    69	        with open(os.path.join(run_dir, "impact.json"), encoding="utf-8") as handle:
    70	            impacted = json.load(handle).get("impacted", [])
    71	    except (OSError, AttributeError, json.JSONDecodeError):
    72	        return {}
    73	    return {entry["path"]: entry.get("provenance", "unknown")
    74	            for entry in impacted
    75	            if isinstance(entry, dict) and isinstance(entry.get("path"), str)}
