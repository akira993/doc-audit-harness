   198	def findings_fail(value):
   199	    if not isinstance(value, dict):
   200	        raise Refused("phase evidence must be an object")
   201	    findings = value.get("findings", [])
   202	    if not isinstance(findings, list):
   203	        raise Refused("phase findings must be an array")
   204	    blocking = False
   205	    for finding in findings:
   206	        if not isinstance(finding, dict):
   207	            raise Refused("phase finding is not an object")
   208	        raw_severity = finding.get("severity")
   209	        if not isinstance(raw_severity, str) or not raw_severity.strip():
   210	            raise Refused("phase finding severity is missing")
   211	        severity = raw_severity.strip().upper()
   212	        if severity in FAIL_SEVERITIES:
   213	            blocking = True
   214	        elif severity not in {"PASS", "WARN", "MEDIUM", "LOW", "INFO"}:
   215	            raise Refused(f"unknown finding severity: {severity}")
   216	    if value.get("parsed") is False:
   217	        exit_code = value.get("exitCode", value.get("returncode", 0))
   218	        if isinstance(exit_code, int) and exit_code != 0:
   219	            return True
   220	        commands = value.get("commands", [])
   221	        if isinstance(commands, list) and any(isinstance(item, dict) and item.get("exitCode") not in (None, 0)
   222	                                              for item in commands):
   223	            return True
   224	    return blocking
