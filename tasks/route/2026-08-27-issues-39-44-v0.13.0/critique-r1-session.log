   227	def run_tree_digest(repo, manifest):
   228	    command = [sys.executable, os.path.join(HERE, "tree-digest.py"),
   229	               "--repo-root", repo, "--include-head"]
   230	    for item in manifest.get("digestExclude", []):
   231	        command.extend(["--exclude", item])
   232	    proc = subprocess.run(command, capture_output=True, text=True)
   233	    if proc.returncode:
   234	        raise Refused(proc.stderr.strip() or "tree-digest failed")
   235	    return json.loads(proc.stdout)["digest"]
