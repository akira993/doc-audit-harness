     1	#!/usr/bin/env python3
     2	"""Resolve changed paths to audit-document candidates.
     3	
     4	Positional paths are a test/investigation mode; omit them for the pre-commit
     5	git-based mode.  The implementation intentionally uses only Python's stdlib.
     6	"""
     7	import argparse
     8	import fnmatch
     9	import json
    10	import subprocess
    11	import sys
    12	from pathlib import Path
    13	
    14	
    15	CATCH_ALL = {"*", "**", "**/*"}
    16	
    17	
    18	class JSONObject(list):
    19	    """A JSON object which preserves duplicate keys while parsing."""
    20	
    21	
    22	def root_from_script():
    23	    return Path(__file__).resolve().parent.parent
    24	
    25	
    26	def load_map(path):
    27	    try:
    28	        raw = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=JSONObject)
    29	    except (OSError, json.JSONDecodeError) as exc:
    30	        return None, [f"マップを読めません: {exc}"]
    31	    if not isinstance(raw, JSONObject):
    32	        return None, ["マップの最上位は JSON object である必要があります"]
    33	    duplicates = {key for key, _ in raw if sum(key == other for other, _ in raw) > 1}
    34	    return raw, [f"同一 glob が重複しています: {key}" for key in sorted(duplicates)]
    35	
    36	
    37	def validate_map(rules, root):
    38	    errors = []
    39	    for glob, value in rules:
    40	        if not isinstance(glob, str):
    41	            errors.append("glob は文字列である必要があります")
    42	            continue
    43	        if glob in CATCH_ALL:
    44	            errors.append(f"裸の catch-all は使えません: {glob}")
    45	        if isinstance(value, JSONObject):
    46	            if list(value) != [("impact", "none")]:
    47	                errors.append(f"規則の値が不正です: {glob}")
    48	        elif isinstance(value, list):
    49	            if not value:
    50	                errors.append(f"影響先が空です: {glob}")
    51	            for target in value:
    52	                if not isinstance(target, str):
    53	                    errors.append(f"影響先は文字列である必要があります: {glob}")
    54	                elif not (root / target).is_file():
    55	                    errors.append(f"影響先が存在しません: {glob} -> {target}")
    56	        else:
    57	            errors.append(f"規則の値が不正です: {glob}")
    58	    return errors
    59	
    60	
    61	def git_paths(root, revision):
    62	    try:
    63	        diff = subprocess.run(
    64	            ["git", "diff", "--name-status", "-z", revision], cwd=root,
    65	            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    66	        ).stdout
    67	        untracked = subprocess.run(
    68	            ["git", "ls-files", "--others", "--exclude-standard", "-z"], cwd=root,
    69	            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True,
    70	        ).stdout
    71	    except (OSError, subprocess.CalledProcessError) as exc:
    72	        detail = getattr(exc, "stderr", b"").decode("utf-8", "replace").strip()
    73	        raise RuntimeError(detail or "git の差分を取得できません") from exc
    74	    fields = diff.decode("utf-8", "surrogateescape").split("\0")
    75	    paths, index = [], 0
    76	    while index < len(fields) - 1:
    77	        status = fields[index]
    78	        index += 1
    79	        if not status:
    80	            continue
    81	        if index >= len(fields):
    82	            raise RuntimeError("git diff の name-status 出力が壊れています")
    83	        first = fields[index]
    84	        index += 1
    85	        if status[0] in {"R", "C"}:
    86	            if index >= len(fields):
    87	                raise RuntimeError("git diff の rename 出力が壊れています")
    88	            paths.append(fields[index])  # rename/copy: new path
    89	            index += 1
    90	        else:
    91	            paths.append(first)  # deletion deliberately retains its old path
    92	    paths.extend(item for item in untracked.decode("utf-8", "surrogateescape").split("\0") if item)
    93	    return sorted(set(paths))
    94	
    95	
    96	def resolve(paths, rules):
    97	    candidates, no_impact, unmapped = set(), [], []
    98	    for path in paths:
    99	        matched = False
   100	        none = False
   101	        for glob, value in rules:
   102	            if fnmatch.fnmatchcase(path, glob):
   103	                matched = True
   104	                if isinstance(value, JSONObject):
   105	                    none = True
   106	                else:
   107	                    candidates.update(value)
   108	        if not matched:
   109	            unmapped.append(path)
   110	        elif none and not any(fnmatch.fnmatchcase(path, glob) and isinstance(value, list) and not isinstance(value, JSONObject)
   111	                          for glob, value in rules):
   112	            no_impact.append(path)
   113	    return sorted(candidates), sorted(no_impact), sorted(unmapped)
   114	
   115	
   116	def main():
   117	    parser = argparse.ArgumentParser(description=__doc__)
   118	    parser.add_argument("--from", dest="revision", default="HEAD", help="git diff の基準 revision")
   119	    parser.add_argument("--map", dest="map_path", help="テスト用のマップ JSON")
   120	    parser.add_argument("--root", type=Path, help="リポジトリ root（既定はスクリプト位置由来）")
   121	    parser.add_argument("--validate", action="store_true", help="全規則だけを検証する")
   122	    parser.add_argument("paths", nargs="*", help="テスト・調査用の明示パス（通常のコミット前ゲートでは使わない）")
   123	    args = parser.parse_args()
   124	    root = (args.root or root_from_script()).resolve()
   125	    map_path = (args.map_path and Path(args.map_path)) or root / ".claude/audit-scope.json"
   126	    if not map_path.is_absolute():
   127	        map_path = root / map_path
   128	    rules, errors = load_map(map_path)
   129	    if rules is None:
   130	        print("\n".join(errors))
   131	        return 2
   132	    errors.extend(validate_map(rules, root))
   133	    if args.validate:
   134	        print(f"規則 {len(rules)} 件を検証")
   135	        if errors:
   136	            print("\n".join(f"FAIL: {error}" for error in errors))
   137	            return 2
   138	        return 0
   139	    if errors:
   140	        print("\n".join(f"FAIL: {error}" for error in errors))
   141	        return 2
   142	    if args.paths:
   143	        paths = args.paths
   144	    else:
   145	        try:
   146	            paths = git_paths(root, args.revision)
   147	        except RuntimeError as exc:
   148	            print(f"エラー: git が使えないため既定モードを実行できません: {exc}")
   149	            return 2
   150	    candidates, no_impact, unmapped = resolve(paths, rules)
   151	    print("確認候補文書:")
   152	    for target in candidates:
   153	        print(f"- {target}")
   154	    if no_impact:
   155	        print("NO_IMPACT:")
   156	        for path in no_impact:
   157	            print(f"- {path}")
   158	    if unmapped:
   159	        print("UNMAPPED:")
   160	        for path in unmapped:
   161	            print(f"- {path}")
   162	        print("貼り付け用 JSON 規則断片:")
   163	        for path in unmapped:
   164	            print(f"  {json.dumps(path, ensure_ascii=False)}: [\"docs/README.md\"],")
   165	    print(f"対象 {len(paths)} 件を検査（UNMAPPED {len(unmapped)}・NO_IMPACT {len(no_impact)}）")
   166	    return 2 if unmapped else 0
   167	
   168	
   169	if __name__ == "__main__":
