    37	def validate_repo_path(repo_root, path, *, must_exist=True, regular_file=True):
    38	    """Return normalized repo path or raise ValueError.
    39	
    40	    Absolute paths, dot traversal, every symlink component, repository escapes,
    41	    missing paths, and non-regular final files are rejected.
    42	    """
    43	    if not isinstance(path, str) or not path or os.path.isabs(path):
    44	        raise ValueError("path must be a non-empty repository-relative string")
    45	    path = path.replace("\\", "/")
    46	    parts = path.split("/")
    47	    if any(part in ("", ".", "..") for part in parts):
    48	        raise ValueError("path contains an empty, dot, or parent component")
    49	    root = os.path.realpath(repo_root)
    50	    current = root
    51	    for part in parts:
    52	        current = os.path.join(current, part)
    53	        if os.path.lexists(current) and os.path.islink(current):
    54	            raise ValueError("symlink paths are not accepted")
