   238	def lock_recheck(fd, lock_path, runid, expected_inode):
   239	    try:
   240	        inode_fd = os.fstat(fd).st_ino
   241	        inode_path = os.stat(lock_path, follow_symlinks=False).st_ino
   242	    except OSError as exc:
   243	        raise Refused(f"lock disappeared or changed: {exc}") from exc
   244	    os.lseek(fd, 0, os.SEEK_SET)
   245	    raw = os.read(fd, 65536)
   246	    holder = parse_json(raw, "lock")
   247	    if inode_fd != inode_path or inode_fd != expected_inode or holder.get("runid") != runid:
   248	        raise Refused("lock inode or runid mismatch")
   249	    return holder
