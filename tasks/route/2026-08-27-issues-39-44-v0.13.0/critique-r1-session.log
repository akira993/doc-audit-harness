   145	def _markdown_with_stamp(text, name, version, digest):
   146	    lines = text.splitlines(keepends=True)
   147	    if not lines or lines[0].rstrip("\r\n") != "---":
   148	        raise ValueError(f"{name}: front matter must be first")
   149	    for index in range(1, len(lines)):
   150	        if lines[index].rstrip("\r\n") == "---":
   151	            stamp = f"<!-- docaudit-template: {name}@{version} sha256:{digest} -->\n"
   152	            return "".join(lines[:index + 1] + [stamp] + lines[index + 1:])
   153	    raise ValueError(f"{name}: front matter is not closed")
   154	
   155	
   156	def _python_with_stamp(text, name, version, digest):
   157	    lines = text.splitlines(keepends=True)
   158	    if not lines or not lines[0].startswith("#!"):
   159	        raise ValueError("check-docs engine must start with a shebang")
   160	    stamp = f"# docaudit-template: {name}@{version} sha256:{digest}\n"
   161	    return "".join([lines[0], stamp] + lines[1:])
