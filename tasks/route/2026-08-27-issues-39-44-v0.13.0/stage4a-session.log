+        self.assertEqual(impact["counts"]["heuristicOnly"], 0)
+        self.assertEqual(dispatch["cached"], [])
+        self.assertEqual(set(dispatch["dispatch"]), set(manifest["impacted"]))
+        self.assertEqual(manifest["provenance"], {
