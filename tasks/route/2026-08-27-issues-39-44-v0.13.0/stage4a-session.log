+            self.history_entry("docs/regression.md", "old-run")]} ) + "\n")
+        self.assertEqual(fx.open().returncode, 0)
+
+        impact, dispatch, manifest, gate = self.run_chain(fx, ["src/unrelated.py"])
+
+        expected = {"docs/regression.md": "regression"}
