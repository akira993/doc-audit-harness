+    def test_regression_document_traverses_the_complete_sealed_chain(self):
+        fx = RunFixture(self, docs=("docs/regression.md",), config_extra={
+            "regressionRecheck": {"enabled": True}})
+        write(fx.history, json.dumps({"entries": [
