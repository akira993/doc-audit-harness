+        self.assertEqual(dispatch["dispatch"], ["docs/regression.md"])
+        self.assertEqual(dispatch["cached"], [])
+        self.assertEqual(manifest["provenance"], expected)
+        self.assertEqual(gate["verdict"], "CONSISTENT")
