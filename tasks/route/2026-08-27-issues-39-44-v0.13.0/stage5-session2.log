+        return self.state
+
+    def run_handoff(self, *args, answer="y\n", destination=None, skills_root=None):
+        env = os.environ.copy()
+        env.update({
+            "PATH": self.bin_dir + os.pathsep + "/usr/bin:/bin",
+            "FAKE_STATE": self.state_path,
