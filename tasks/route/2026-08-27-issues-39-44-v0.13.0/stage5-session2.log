+    def install_fake_tools(self):
+        shebang = f"#!{sys.executable}\n"
+        for name in ("git", "gh", "python3", "rsync"):
+            path = os.path.join(self.bin_dir, name)
+            with open(path, "w", encoding="utf-8") as handle:
+                handle.write(shebang + FAKE_TOOL)
+            os.chmod(path, 0o755)
